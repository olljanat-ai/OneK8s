<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The chiseled runtime image carries no ICU, so the app must run
         invariant. Nothing here formats for a culture, and every string the
         database returns is NVARCHAR, so no code page is needed either. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The chiseled runtime image starts the app as "dotnet db-hello.dll". -->
    <AssemblyName>db-hello</AssemblyName>
    <RootNamespace>OneK8s.DbHello</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Azure.Identity mints the Entra token from the projected ServiceAccount
         token the workload identity webhook mounts; SqlClient carries it to
         Azure SQL as SqlConnection.AccessToken. Between them they are the
         entire "no password" story, and they are the only dependencies. -->
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
  </ItemGroup>

</Project>
